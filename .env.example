# Public application origin used to construct OAuth callback URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase project settings. The anon key is intentionally browser-safe; RLS
# remains the authorization boundary for every client query.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose this value through a NEXT_PUBLIC_* variable.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only 32-byte key (base64, base64url, or hex) used for AES-256-GCM
# encryption of Postgres and Google connector credentials.
ENCRYPTION_KEY=

# Server-only Google Gemini free-tier AI. Never expose this key through a
# NEXT_PUBLIC_* variable. The defaults below produce structured plans and
# 1,536-dimensional pgvector embeddings.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Configure these exact redirect URLs in Supabase and each OAuth provider:
# Local:      http://localhost:3000/auth/callback
# Production: https://your-domain.example/auth/callback
